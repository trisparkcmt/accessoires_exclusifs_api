[Unit]
Description=Gunicorn — Serveur WSGI pour Accessoires Exclusifs
# network-online.target garantit que la pile réseau ET le DNS sont opérationnels
# avant le démarrage (network.target = interface UP seulement, pas DNS).
After=network-online.target
Wants=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/accessoiresexclusifs
EnvironmentFile=/var/www/accessoiresexclusifs/.env

ExecStart=/var/www/accessoiresexclusifs/venv/bin/gunicorn \
          --workers 3 \
          --worker-class gthread \
          --threads 4 \
          --worker-connections 1000 \
          --timeout 200 \
          --keep-alive 5 \
          --max-requests 1000 \
          --max-requests-jitter 50 \
          --bind unix:/run/gunicorn/gunicorn.sock \
          --access-logfile - \
          --error-logfile - \
          --access-logformat 'IP: %({X-Forwarded-For}i)s | "%(r)s" | Status: %(s)s | Durée: %(L)ss | Origine: "%(f)s" | Client: "%(a)s"' \
          --log-level info \
          backend.wsgi:application

# Créer le dossier du socket au démarrage
RuntimeDirectory=gunicorn
RuntimeDirectoryMode=0755

# Redémarrage automatique si le service plante
Restart=on-failure
RestartSec=5s

# Limites de sécurité
NoNewPrivileges=true
# PrivateTmp=true est retiré car il peut bloquer la résolution DNS
# (isole /tmp dans un namespace privé, parfois en conflit avec systemd-resolved).
# PrivateTmp=true

[Install]
WantedBy=multi-user.target
