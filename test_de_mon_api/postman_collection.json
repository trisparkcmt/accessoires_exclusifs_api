            }
          }
        },
        {
          "name": "Prestataires - LECTURE SEULE (Serveuse)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serveuse_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/admin/prestataires/",
              "protocol": "http",
              "host": ["127.0.0.1"],
              "port": "8000",
              "path": ["api", "v1", "auth", "admin", "prestataires", ""]
            }
          }
        },
        {
          "name": "Livreurs - LECTURE SEULE (Serveuse)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serveuse_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/admin/livreurs/",
              "protocol": "http",
              "host": ["127.0.0.1"],
              "port": "8000",
              "path": ["api", "v1", "auth", "admin", "livreurs", ""]
            }
          }
        }
      ]
    },
    {
      "name": "4️⃣ TEST - ACCÈS REFUSÉ (403)",
      "description": "Tests pour vérifier que les permissions sont bien appliquées",
      "item": [
        {
          "name": "Serveuse -> Stats Globales (DOIT ÉCHOUER)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serveuse_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/admin/stats/global/",
              "protocol": "http",
              "host": ["127.0.0.1"],
              "port": "8000",
              "path": ["api", "v1", "auth", "admin", "stats", "global", ""]
            }
          }
        },
        {
          "name": "Serveuse -> Lister Serveuses (DOIT ÉCHOUER)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serveuse_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/admin/serveuses/",
