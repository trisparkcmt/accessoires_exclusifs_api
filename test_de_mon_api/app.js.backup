        ['GET', '/api/v1/shop/types-flacon/', 'Lister types flacon'],
        ['POST', '/api/v1/shop/types-flacon/', 'Creer type flacon', { nom: 'Type test', slug: 'type-test', description: 'Desc', actif: true }],
        ['PATCH', '/api/v1/shop/types-flacon/{slug}/', 'Modifier type flacon', { nom: 'Type maj' }, { slug: 'type-test' }],
        ['GET', '/api/v1/shop/produits-essence/', 'Lister produits essence'],
        ['POST', '/api/v1/shop/produits-essence/', 'Creer produit essence', { essence: 1, taille_ml: 50, prix: 15000, stock_disponible: 10, actif: true }],
        ['PATCH', '/api/v1/shop/produits-essence/{id}/', 'Modifier produit essence', { prix: 16000 }, { id: 1 }],
        ['GET', '/api/v1/lab/ia-recommandation/', 'IA recommandation GET'],
        ['POST', '/api/v1/lab/ia-recommandation/', 'IA recommandation', { prompt: 'Je veux un parfum doux et floral' }],
        ['GET', '/api/v1/lab/parfums-perso/', 'Lister parfums perso'],
        ['POST', '/api/v1/lab/parfums-perso/', 'Creer parfum perso', {}],
        ['GET', '/api/v1/lab/parfums-perso/{id}/', 'Detail parfum perso', null, { id: 1 }],
        ['PATCH', '/api/v1/lab/parfums-perso/{id}/', 'Modifier parfum perso', {}, { id: 1 }],
        ['DELETE', '/api/v1/lab/parfums-perso/{id}/', 'Supprimer parfum perso', null, { id: 1 }],
        ['POST', '/api/v1/lab/parfums-perso/{id}/recalculer/', 'Recalculer parfum perso', null, { id: 1 }],
        ['GET', '/api/v1/lab/essences-perso/', 'Lister essences perso'],
        ['POST', '/api/v1/lab/essences-perso/', 'Creer essence perso', {}],
        ['GET', '/api/v1/lab/essences-perso/{id}/', 'Detail essence perso', null, { id: 1 }],
        ['PATCH', '/api/v1/lab/essences-perso/{id}/', 'Modifier essence perso', {}, { id: 1 }],
        ['DELETE', '/api/v1/lab/essences-perso/{id}/', 'Supprimer essence perso', null, { id: 1 }],
        ['GET', '/api/v1/lab/essences/', 'Lister essences'],
        ['POST', '/api/v1/lab/essences/', 'Creer essence', {}],
        ['GET', '/api/v1/lab/essences/{id}/', 'Detail essence', null, { id: 1 }],
        ['PATCH', '/api/v1/lab/essences/{id}/', 'Modifier essence', {}, { id: 1 }],
        ['DELETE', '/api/v1/lab/essences/{id}/', 'Supprimer essence', null, { id: 1 }],
        ['GET', '/api/v1/lab/ingredients/', 'Lister ingredients'],
        ['POST', '/api/v1/lab/ingredients/', 'Creer ingredient', {}],
        ['GET', '/api/v1/lab/ingredients/{id}/', 'Detail ingredient', null, { id: 1 }],
        ['PATCH', '/api/v1/lab/ingredients/{id}/', 'Modifier ingredient', {}, { id: 1 }],
        ['DELETE', '/api/v1/lab/ingredients/{id}/', 'Supprimer ingredient', null, { id: 1 }],
        ['GET', '/api/v1/lab/lots-essence/', 'Lister lots essence'],
        ['POST', '/api/v1/lab/lots-essence/', 'Creer lot essence', { essence: 1, stock_ml: 500, seuil_alerte_ml: 50, reference_fournisseur: 'FOURN-1', actif: true }],
        ['PATCH', '/api/v1/lab/lots-essence/{id}/', 'Modifier lot essence', { stock_ml: 600 }, { id: 1 }],
        ['GET', '/api/v1/lab/labo/essences/disponible/', 'Stock disponible essences labo'],
        ['GET', '/api/v1/lab/labo/essences/{slug}/detail/', 'Detail essence labo', null, { slug: 'essence-rose' }],
        ['GET', '/api/v1/utilisateur/notifications/', 'Notifications admin'],
        ['GET', '/api/v1/utilisateur/prestataire-requests/', 'Demandes prestataires'],
        ['GET', '/api/v1/utilisateur/prestataire-requests/{pk}/', 'Detail demande prestataire', null, { pk: 1 }]
    ];

    function pathParametersFromPath(path, defaults = {}) {
        const params = [];
        [...path.matchAll(/\{([^}]+)\}/g)].forEach(match => {
            params.push({
                name: match[1],
                in: 'path',
                schema: typeof defaults[match[1]] === 'number' ? { type: 'integer' } : { type: 'string' },
                defaultValue: defaults[match[1]] !== undefined ? defaults[match[1]] : (match[1].includes('id') || match[1] === 'pk' ? 1 : 'test')
            });
        });
        return params;
    }

    function knownEndpointToOperation(item) {
        const [method, path, label, exampleBody = null, pathDefaults = {}] = item;
        return {
            method,
            path,
            label,
            summary: label,
            tags: [],
            parameters: pathParametersFromPath(path, pathDefaults),
            requestBody: exampleBody ? { content: { 'application/json': { schema: { example: exampleBody } } } } : null,
            operation: { summary: label, requestBody: exampleBody ? { content: { 'application/json': { schema: { example: exampleBody } } } } : null },
            known: true
        };
    }

    function mergeKnownOperations(operations) {
        const byKey = new Map();
        [...operations, ...KNOWN_ENDPOINTS.map(knownEndpointToOperation)].forEach(op => {
            const key = `${op.method} ${op.path}`;
            if (!byKey.has(key)) byKey.set(key, op);
        });
        return [...byKey.values()].sort((a, b) => `${a.path} ${a.method}`.localeCompare(`${b.path} ${b.method}`));
    }

    function classifyOperation(op) {
        const path = op.path.toLowerCase();
        if (path.includes('/api/schema') || path.includes('/api/docs') || path.includes('/api/redoc')) return 'schema';
        if (path.includes('/api/v1/auth/admin/')) return 'admin';
        if (path.includes('/api/v1/auth/livreur/')) return 'livreur';
        if (path.includes('/api/v1/auth/')) return 'auth';
        if (path.includes('/api/v1/shop/')) return 'shop';
        if (path.includes('/api/v1/lab/')) return 'lab';
        if (path.includes('/api/v1/orders/')) return 'orders';
        if (path.includes('/api/v1/utilisateur/')) return 'utilisateur';
        return 'other';
    }

    async function ensureOpenAPIOperations() {
        if (endpointExplorer.operations.length) return endpointExplorer.operations;
        try {
            const schema = await fetchOpenAPISchema();
            endpointExplorer.operations = mergeKnownOperations(extractOperations(schema));
        } catch (error) {
            endpointExplorer.operations = mergeKnownOperations([]);
            document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON({
                warning: 'Schema OpenAPI indisponible. Utilisation de la liste locale des endpoints.',
                detail: error.message
            });
        }
        renderEndpointList();
        return endpointExplorer.operations;
    }

    function categoryOrder(category) {
        return ['all', 'auth', 'shop', 'lab', 'orders', 'livreur', 'admin', 'utilisateur', 'schema', 'other'].indexOf(category);
    }

    function renderQuickCategoryTabs() {
        const tabs = document.getElementById('quick-category-tabs');
        const categories = ['all', ...new Set(endpointExplorer.operations.map(classifyOperation))]
            .sort((a, b) => categoryOrder(a) - categoryOrder(b));
        quickTests.categories = categories;
        tabs.innerHTML = '';
        categories.forEach(category => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `tab-sub-btn ${category === quickTests.activeCategory ? 'active' : ''}`;
            btn.dataset.category = category;
            btn.textContent = QUICK_CATEGORY_LABELS[category] || category;
            btn.addEventListener('click', () => {
                quickTests.activeCategory = category;
                renderQuickCategoryTabs();
                renderQuickTestCards();
            });
            tabs.appendChild(btn);
        });
    }

    function canSendDirectly(op) {
        const hasBody = !!requestBodyExample(op.operation);
        const requiredPathParams = op.parameters.some(param => param.in === 'path');
        return op.method === 'GET' && !requiredPathParams && !hasBody;
    }

    function prepareOperationInFullTester(op, pathParamOverrides = {}) {
        const index = endpointExplorer.operations.indexOf(op);
        document.querySelector('.nav-btn[data-target="endpoint-panel"]').click();
        renderEndpointList();
        selectEndpoint(index);

        if (Object.keys(pathParamOverrides).length > 0) {
            const currentPathParams = parseLooseJSON(document.getElementById('endpoint-path-values').value, {});
            const merged = { ...currentPathParams, ...pathParamOverrides };
            document.getElementById('endpoint-path-values').value = JSON.stringify(merged, null, 2);
        }
    }

    function defaultValueForParameter(param) {
        if (param.defaultValue !== undefined) return param.defaultValue;
        const type = param.schema && param.schema.type;
        if (type === 'integer' || type === 'number') return 1;
        if (type === 'boolean') return true;
        return 'test';
    }

    function buildExampleRequestForOperation(op, card = null) {
        let path = op.path;
        const query = new URLSearchParams();
        const pathValues = card ? parseLooseJSON(card.querySelector('.quick-path-values').value, {}) : {};
        const queryValues = card ? parseLooseJSON(card.querySelector('.quick-query-values').value, {}) : {};
        const bodyText = card ? card.querySelector('.quick-body-values').value.trim() : requestBodyExample(op.operation);

        op.parameters.forEach(param => {
            const value = param.in === 'path'
                ? (pathValues[param.name] !== undefined ? pathValues[param.name] : defaultValueForParameter(param))
                : queryValues[param.name];
            if (param.in === 'path') path = path.replace(`{${param.name}}`, encodeURIComponent(value));
        });

        Object.entries(queryValues).forEach(([key, value]) => {
            if (value !== '' && value !== null && value !== undefined) query.append(key, value);
        });

        const endpoint = query.toString() ? `${path}?${query}` : path;
        const body = bodyText ? parseLooseJSON(bodyText, {}) : null;
        return { endpoint, method: op.method, body, headers: {} };
    }

    function quickInitialPathValues(op) {
        const values = {};
        op.parameters.filter(param => param.in === 'path').forEach(param => {
            values[param.name] = defaultValueForParameter(param);
        });
        return values;
    }

    function quickInitialQueryValues(op) {
        const values = {};
        op.parameters.filter(param => param.in === 'query' && param.required).forEach(param => {
            values[param.name] = defaultValueForParameter(param);
        });
        return values;
    }

    function updateQuickUrlPreview(card, op) {
        try {
            const request = buildExampleRequestForOperation(op, card);
            card.querySelector('.quick-url-preview').textContent = `${state.apiBaseUrl}${request.endpoint}`;
        } catch (error) {
            card.querySelector('.quick-url-preview').textContent = 'JSON invalide dans la carte';
        }
    }

    function renderQuickTestCards() {
        const grid = document.getElementById('quick-tests-grid');
        const category = quickTests.activeCategory;
        const operations = endpointExplorer.operations.filter(op => category === 'all' || classifyOperation(op) === category);

        if (!operations.length) {
            grid.innerHTML = `
                <div class="card empty-quick-tests">
                    <h3>Aucun endpoint dans cette page</h3>
                    <p class="text-muted">Charge le schema ou choisis une autre categorie.</p>
                </div>
            `;
            return;
        }

        grid.innerHTML = '';
        operations.forEach(op => {
            const card = document.createElement('article');
            card.className = 'quick-endpoint-card';
            const pathValues = quickInitialPathValues(op);
            const queryValues = quickInitialQueryValues(op);
            const bodyExample = requestBodyExample(op.operation);
            card.innerHTML = `
                <div class="quick-card-top">
                    <span class="method-pill method-${op.method.toLowerCase()}">${op.method}</span>
                    <span class="quick-category">${QUICK_CATEGORY_LABELS[classifyOperation(op)] || classifyOperation(op)}</span>
                </div>
                <h3>${op.label}</h3>
                <code>${op.path}</code>
                <div class="quick-url-preview"></div>
                <details class="quick-card-fields" ${Object.keys(pathValues).length || Object.keys(queryValues).length || bodyExample ? 'open' : ''}>
                    <summary>Parametres de test</summary>
                    <label>Path params JSON</label>
                    <textarea class="quick-path-values" rows="3">${Object.keys(pathValues).length ? JSON.stringify(pathValues, null, 2) : ''}</textarea>
                    <label>Query params JSON</label>
                    <textarea class="quick-query-values" rows="3">${Object.keys(queryValues).length ? JSON.stringify(queryValues, null, 2) : ''}</textarea>
                    <label>Body JSON</label>
                    <textarea class="quick-body-values" rows="5">${bodyExample || ''}</textarea>
                </details>
                <div class="quick-card-actions">
                    <button type="button" class="btn btn-primary btn-sm quick-send">Tester cet endpoint</button>
                    <button type="button" class="btn btn-secondary btn-sm quick-prepare">Modifier dans le testeur complet</button>
                </div>
            `;
            card.querySelectorAll('textarea').forEach(textarea => {
                textarea.addEventListener('input', () => updateQuickUrlPreview(card, op));
            });
            card.querySelector('.quick-prepare').addEventListener('click', () => prepareOperationInFullTester(op));
            card.querySelector('.quick-send').addEventListener('click', async () => {
                try {
                    const request = buildExampleRequestForOperation(op, card);
                    updateQuickUrlPreview(card, op);
                    await makeAPIRequest(request.endpoint, request.method, request.body, request.headers);
                } catch (error) {
                    document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON({ error: error.message });
                    document.getElementById('response-status').textContent = 'STATUS : FORMULAIRE';
                    document.getElementById('response-status').className = 'badge badge-4xx';
                }
            });
            updateQuickUrlPreview(card, op);
            grid.appendChild(card);
        });
    }

    async function loadQuickTestPages() {
        const grid = document.getElementById('quick-tests-grid');
        grid.innerHTML = `
            <div class="card empty-quick-tests">
                <h3>Chargement...</h3>
                <p class="text-muted">Lecture de /api/schema/ en cours.</p>
            </div>
        `;
        try {
            await ensureOpenAPIOperations();
            renderQuickCategoryTabs();
            renderQuickTestCards();
            document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON({
                info: `${endpointExplorer.operations.length} endpoints disponibles dans les pages de test pratiques.`
            });
        } catch (error) {
            grid.innerHTML = `
                <div class="card empty-quick-tests">
                    <h3>Impossible de charger les endpoints</h3>
                    <p class="text-muted">${error.message}</p>
                </div>
            `;
            document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON({ error: error.message });
        }
    }

    document.getElementById('btn-load-quick-tests').addEventListener('click', loadQuickTestPages);
    document.getElementById('btn-open-full-endpoints').addEventListener('click', () => {
        document.querySelector('.nav-btn[data-target="endpoint-panel"]').click();
    });

    document.querySelector('.nav-btn[data-target="quick-tests-panel"]').addEventListener('click', () => {
        if (!endpointExplorer.operations.length) loadQuickTestPages();
    });

    // -------------------------------------------------------------------------
    // 12. INITIALIZATION
    // -------------------------------------------------------------------------
    // Register click listeners to switch response panels
    document.querySelectorAll('.viewer-tab').forEach(btn => {
        btn.addEventListener('click', () => {
            switchResponseTab(btn.dataset.responseTab);
        });
    });

    updateAuthStatus();
});
