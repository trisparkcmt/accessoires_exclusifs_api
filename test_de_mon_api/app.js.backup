    async function addFavori(parfumId) {
        await makeAPIRequest('/api/v1/shop/favoris/', 'POST', { parfum: parseInt(parfumId) });
    }

    document.getElementById('form-add-favori').addEventListener('submit', async (e) => {
        e.preventDefault();
        const type = document.getElementById('fav-product-type').value;
        const slug = document.getElementById('fav-product-slug').value.trim();
        const resource = type === 'accessoire' ? 'accessoires' : 'parfums';
        if (!slug) return alert('Indique un slug.');

        const detail = await makeAPIRequest(`/api/v1/shop/${resource}/${slug}/`, 'GET');
        if (!detail.ok || !detail.data || !detail.data.id) return;

        // Le backend actuel expose FavoriViewSet en lecture seule. Cette requête teste la création
        // si tu ajoutes create/toggle plus tard; aujourd'hui elle peut répondre 405 Method Not Allowed.
        const body = type === 'accessoire' ? { accessoire: detail.data.id } : { parfum: detail.data.id };
        await makeAPIRequest('/api/v1/shop/favoris/', 'POST', body);
    });

    function renderFavoris(data) {
        const container = document.getElementById('favoris-list-output');
        container.innerHTML = '';
        const results = data.results || data || [];

        if (results.length === 0) {
            container.innerHTML = '<p class="text-muted">Aucun favori pour le moment.</p>';
            return;
        }

        results.forEach(fav => {
            const card = document.createElement('div');
            card.className = 'catalog-card';
            const parfum = fav.parfum_details || {};
            card.innerHTML = `
                <h4>${parfum.nom || 'Parfum ID: ' + fav.parfum}</h4>
                <div class="sku">ID du Favori: ${fav.id}</div>
                <div class="price">${parfum.prix_actuel || ''} FCFA</div>
                <button class="btn btn-danger btn-sm btn-remove-fav mt-2" data-fav-id="${fav.id}">Retirer</button>
            `;
            container.appendChild(card);
        });

        container.querySelectorAll('.btn-remove-fav').forEach(btn => {
            btn.addEventListener('click', async () => {
                const favId = btn.getAttribute('data-fav-id');
                const res = await makeAPIRequest(`/api/v1/shop/favoris/${favId}/`, 'DELETE');
                if (res.ok) {
                    btn.closest('.catalog-card').remove();
                }
            });
        });
    }

