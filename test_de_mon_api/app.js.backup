    function selectEndpoint(index) {
        const op = endpointExplorer.operations[index];
        if (!op) return;
        endpointExplorer.selected = op;

        document.querySelectorAll('.endpoint-item').forEach(item => item.classList.toggle('active', Number(item.dataset.index) === index));
        document.getElementById('endpoint-title').textContent = `${op.method} ${op.path}`;
        document.getElementById('endpoint-summary').textContent = op.label;
        const pill = document.getElementById('endpoint-method-pill');
        pill.textContent = op.method;
        pill.className = `method-pill method-${op.method.toLowerCase()}`;
        document.getElementById('endpoint-method').value = op.method;
        document.getElementById('endpoint-path').value = op.path;

        const pathParams = {};
        const queryParams = {};
        op.parameters.forEach(param => {
            if (param.in === 'path') pathParams[param.name] = expectedPathValue(param.name, op.path);
            if (param.in === 'query') queryParams[param.name] = expectedQueryValue(param, op.path);
        });
        document.getElementById('endpoint-path-values').value = Object.keys(pathParams).length ? JSON.stringify(pathParams, null, 2) : '';
        document.getElementById('endpoint-query-values').value = Object.keys(queryParams).length ? JSON.stringify(queryParams, null, 2) : '';
        
        const method = op.method;
        const schemaBody = requestBodyExample(op.operation);
        document.getElementById('endpoint-body').value = getExpectedBody(method, op.path, schemaBody);
    }

    function buildEndpointRequest() {
        const method = document.getElementById('endpoint-method').value;
        let path = document.getElementById('endpoint-path').value.trim();
        const pathValues = parseLooseJSON(document.getElementById('endpoint-path-values').value, {});
        const queryValues = parseLooseJSON(document.getElementById('endpoint-query-values').value, {});
        const extraHeaders = parseLooseJSON(document.getElementById('endpoint-extra-headers').value, {});
        const bodyText = document.getElementById('endpoint-body').value.trim();

        Object.entries(pathValues).forEach(([key, value]) => {
            path = path.replace(`{${key}}`, encodeURIComponent(value));
        });

        const query = new URLSearchParams();
        Object.entries(queryValues).forEach(([key, value]) => {
            if (value !== '' && value !== null && value !== undefined) query.append(key, value);
        });
        const endpoint = query.toString() ? `${path}?${query}` : path;
        const body = bodyText ? parseLooseJSON(bodyText, {}) : null;
        return { endpoint, method, body, headers: extraHeaders };
    }

    function copyText(value) {
        if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(value);
        }
        const textarea = document.createElement('textarea');
        textarea.value = value;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
        return Promise.resolve();
    }

    function buildCurlCommand({ endpoint, method, body, headers }) {
        const parts = [`curl -X ${method}`, `'${state.apiBaseUrl}${endpoint}'`, `-H 'Accept: application/json'`];
        if (state.token) parts.push(`-H 'Authorization: Bearer ${state.token}'`);
        Object.entries(headers).forEach(([key, value]) => parts.push(`-H '${key}: ${value}'`));
        if (body) {
            parts.push(`-H 'Content-Type: application/json'`);
            parts.push(`--data '${JSON.stringify(body).replace(/'/g, "'\\''")}'`);
        }
        return parts.join(' ');
    }

    document.getElementById('btn-load-endpoints').addEventListener('click', async () => {
        const listEl = document.getElementById('endpoint-list');
        listEl.innerHTML = '<p class="text-muted text-center">Chargement du schema...</p>';
        try {
            const schema = await fetchOpenAPISchema();
            endpointExplorer.operations = mergeKnownOperations(extractOperations(schema));
            renderEndpointList();
            document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON({
                info: `${endpointExplorer.operations.length} endpoints charges depuis /api/schema/`,
                titre: schema.info && schema.info.title,
                version: schema.info && schema.info.version
            });
        } catch (error) {
            listEl.innerHTML = `<p class="text-muted text-center">${error.message}</p>`;
            document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON({ error: error.message });
        }
    });

    document.getElementById('endpoint-search').addEventListener('input', renderEndpointList);

    document.getElementById('form-endpoint-tester').addEventListener('submit', async (event) => {
        event.preventDefault();
        try {
            const request = buildEndpointRequest();
            await makeAPIRequest(request.endpoint, request.method, request.body, request.headers);
        } catch (error) {
            document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON({ error: error.message });
            document.getElementById('response-status').textContent = 'STATUS : FORMULAIRE';
            document.getElementById('response-status').className = 'badge badge-4xx';
        }
    });

    document.getElementById('btn-copy-endpoint-curl').addEventListener('click', async () => {
        try {
            const request = buildEndpointRequest();
            await copyText(buildCurlCommand(request));
            document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON({ info: 'Commande cURL copiee dans le presse-papiers.' });
        } catch (error) {
            document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON({ error: error.message });
        }
    });

    document.getElementById('btn-reset-endpoint-form').addEventListener('click', () => {
        ['endpoint-path-values', 'endpoint-query-values', 'endpoint-body', 'endpoint-extra-headers'].forEach(id => {
            document.getElementById(id).value = '';
        });
    });


