    document.getElementById('btn-list-essences-perso').addEventListener('click', async () => {
        const res = await makeAPIRequest('/api/v1/lab/essences-perso/', 'GET');
        const container = document.getElementById('essences-perso-list-output');
        container.innerHTML = '';
        const results = res.data.results || res.data || [];
        results.forEach(ep => {
            const card = document.createElement('div');
            card.className = 'catalog-card';
            card.innerHTML = `
                <h4>${ep.nom}</h4>
                <div class="price">${ep.prix_par_ml_calcule} FCFA/ml</div>
                <div class="sku">Date: ${new Date(ep.date_creation).toLocaleDateString()}</div>
            `;
            container.appendChild(card);
        });
    });

    // Gemini IA Recommandation
    document.getElementById('form-ia-prompt').addEventListener('submit', async (e) => {
        e.preventDefault();
        const prompt = document.getElementById('ia-prompt').value.trim();
        const visualOutput = document.getElementById('ia-visual-response');
        
        visualOutput.innerHTML = '<div class="empty-state"><p>🪄 Analyse de votre envie par Gemini... Veuillez patienter.</p></div>';

        const res = await makeAPIRequest('/api/v1/lab/ia-recommandation/', 'POST', { prompt });
        if (res.ok && res.data) {
            visualOutput.innerHTML = '';
            
            // Render Recommended Parfums
            const parfumsIds = res.data.parfums_existants_recommandes || [];
            if (parfumsIds.length > 0) {
                const section = document.createElement('div');
                section.className = 'ia-rec-section';
                section.innerHTML = '<h4>🌹 Parfums Recommandés (Existants)</h4>';
                const grid = document.createElement('div');
                grid.className = 'ia-rec-grid';
                parfumsIds.forEach(id => {
                    grid.innerHTML += `<div class="ia-rec-card"><div class="title">Parfum ID: ${id}</div><p>Présent dans le catalogue</p></div>`;
                });
                section.appendChild(grid);
                visualOutput.appendChild(section);
            }

            // Render Recommended Essences
            const essences = res.data.essences_pre_faites || [];
            if (essences.length > 0) {
                const section = document.createElement('div');
                section.className = 'ia-rec-section';
                section.innerHTML = '<h4>🧪 Essences Recommandées (Formule)</h4>';
                const grid = document.createElement('div');
                grid.className = 'ia-rec-grid';
                essences.forEach(ess => {
                    grid.innerHTML += `
                        <div class="ia-rec-card">
                            <div class="title">Essence ID: ${ess.id || ess}</div>
                            <div class="qty">Quantité: ${ess.quantite_ml || 0} ml</div>
                        </div>`;
                });
                section.appendChild(grid);
                visualOutput.appendChild(section);
            }

            // Render custom ingredients
            const ingr = res.data.ingredients_sur_mesure || [];
            if (ingr.length > 0) {
                const section = document.createElement('div');
                section.className = 'ia-rec-section';
                section.innerHTML = '<h4>🔬 Mélange d\'Ingrédients Sur-mesure</h4>';
                const grid = document.createElement('div');
                grid.className = 'ia-rec-grid';
                ingr.forEach(ig => {
                    grid.innerHTML += `
                        <div class="ia-rec-card">
                            <div class="title">Ingrédient ID: ${ig.id || ig}</div>
                            <div class="qty">Proportion: ${ig.quantite_ml || ig.pourcentage || 0} %</div>
                        </div>`;
                });
                section.appendChild(grid);
                visualOutput.appendChild(section);
            }

            // Render Flacon
            const flaconId = res.data.flacon_id;
            if (flaconId) {
                const section = document.createElement('div');
                section.className = 'ia-rec-section';
                section.innerHTML = '<h4>🧴 Flacon Recommandé</h4>';
                section.innerHTML += `
                    <div class="ia-rec-card" style="max-width: 250px;">
                        <div class="title">Flacon ID: ${flaconId}</div>
                        <p>Contenance estimée: ${res.data.quantite_demandee_ml || 50} ml</p>
                    </div>`;
                visualOutput.appendChild(section);
            }

            if (visualOutput.children.length === 0) {
                visualOutput.innerHTML = '<div class="empty-state"><p>L\'IA a répondu mais aucun produit spécifique n\'a été recommandé.</p></div>';
            }
        } else {
            visualOutput.innerHTML = '<div class="empty-state"><p class="text-muted">❌ Impossible d\'obtenir des recommandations de l\'IA.</p></div>';
        }
    });

