    // Update Profile
    document.getElementById('form-update-profile').addEventListener('submit', async (e) => {
        e.preventDefault();
        const body = {};
        const firstName = document.getElementById('profile-first-name').value.trim();
        const lastName = document.getElementById('profile-last-name').value.trim();
        const telephone = document.getElementById('profile-telephone').value.trim();
        const currentPassword = document.getElementById('profile-password').value;

        if (firstName) body.first_name = firstName;
        if (lastName) body.last_name = lastName;
        if (telephone) body.telephone = telephone;
        if (currentPassword) body.current_password = currentPassword;

        if (Object.keys(body).length === 0) {
            return alert('Renseigne au moins un champ à modifier.');
        }

        await makeAPIRequest('/api/v1/auth/me/', 'PATCH', body);
    });

