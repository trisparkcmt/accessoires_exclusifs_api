    // Create Custom Essence
    document.getElementById('form-create-essence-perso').addEventListener('submit', async (e) => {
        e.preventDefault();
        const nom = document.getElementById('ep-nom').value.trim();
        const lines = [];
        document.querySelectorAll('.ingredient-lines-inputs .line-input').forEach(div => {
            const ingredient = parseInt(div.querySelector('.ing-id').value);
            const pourcentage = parseInt(div.querySelector('.ing-pct').value);
            if (ingredient && pourcentage) {
                lines.push({ ingredient, pourcentage });
            }
        });

        await makeAPIRequest('/api/v1/lab/essences-perso/', 'POST', { nom, lignes: lines });
    });

    // Create Custom Parfum
    document.getElementById('form-create-parfum-perso').addEventListener('submit', async (e) => {
        e.preventDefault();
        const nom = document.getElementById('pp-nom').value.trim();
        const description = document.getElementById('pp-description').value.trim();
        const flacon = parseInt(document.getElementById('pp-flacon').value);

        const lines = [];
        document.querySelectorAll('.essence-lines-inputs .line-input').forEach(div => {
            const type = div.querySelector('.ess-type').value;
            const essenceId = parseInt(div.querySelector('.ess-id').value);
            const quantite_ml = parseFloat(div.querySelector('.ess-vol').value);

            if (essenceId && quantite_ml) {
                const lineObj = { quantite_ml };
                if (type === 'catalogue') {
                    lineObj.essence_catalogue = essenceId;
                } else {
                    lineObj.essence_personnalisee = essenceId;
                }
                lines.push(lineObj);
            }
        });

        await makeAPIRequest('/api/v1/lab/parfums-perso/', 'POST', { nom, description, flacon, lignes: lines });
    });

