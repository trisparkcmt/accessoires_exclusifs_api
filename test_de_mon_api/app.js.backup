// API Test Suite - Core Logic

document.addEventListener('DOMContentLoaded', () => {
    // -------------------------------------------------------------------------
    // 1. SELECTORS & CORE STATE
    // -------------------------------------------------------------------------
    const state = {
        get apiBaseUrl() {
            return document.getElementById('api-base-url').value.trim();
        },
        get token() {
            return localStorage.getItem('jwt_access_token') || '';
        },
        set token(val) {
            if (val) {
                localStorage.setItem('jwt_access_token', val);
                document.getElementById('jwt-token').value = val;
            } else {
                localStorage.removeItem('jwt_access_token');
                document.getElementById('jwt-token').value = '';
            }
            updateAuthStatus();
        },
        get refreshToken() {
            return localStorage.getItem('jwt_refresh_token') || '';
        },
        set refreshToken(val) {
            if (val) {
                localStorage.setItem('jwt_refresh_token', val);
            } else {
                localStorage.removeItem('jwt_refresh_token');
            }
        }
    };

    // Initialize tokens in UI
    if (state.token) {
        document.getElementById('jwt-token').value = state.token;
    }

    // -------------------------------------------------------------------------
    // 2. NAVIGATION (PANELS & SUB-TABS)
    // -------------------------------------------------------------------------
    // Main sidebar navigation
    const navButtons = document.querySelectorAll('.nav-btn');
    const panels = document.querySelectorAll('.panel');

    navButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            navButtons.forEach(b => b.classList.remove('active'));
            panels.forEach(p => p.classList.remove('active'));

            btn.classList.add('active');
            const targetId = btn.getAttribute('data-target');
            const targetPanel = document.getElementById(targetId);
            if (!targetPanel) {
                console.warn(`Panel introuvable: ${targetId}`);
                return;
            }
            targetPanel.classList.add('active');
        });
    });

    // Sub-tabs navigation inside panels
    const subTabButtons = document.querySelectorAll('.tab-sub-btn');
    subTabButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const container = btn.parentElement;
            const parentPanel = container.closest('.panel');
            
            // Toggle buttons in the same container
            container.querySelectorAll('.tab-sub-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            // Toggle sub-panels inside this main panel
            const targetSubId = btn.getAttribute('data-sub');
            parentPanel.querySelectorAll('.sub-panel').forEach(sp => {
                if (sp.id === targetSubId) {
                    sp.classList.add('active');
                } else {
                    sp.classList.remove('active');
                }
            });
        });
    });

    // -------------------------------------------------------------------------
    // 3. API CLIENT HELPER (FETCH WRAPPER)
    // -------------------------------------------------------------------------
    let lastRequest = null;

    function displayNetworkErrorBanner(url, message) {
        const existing = document.getElementById('api-network-error-banner');
        if (existing) existing.remove();

        const panel = document.getElementById('response-json-panel');
        if (!panel) return;

        const banner = document.createElement('div');
        banner.className = 'network-error-banner';
        banner.id = 'api-network-error-banner';
        banner.innerHTML = `
            <h4>⚠️ Échec de la connexion à l'API (${message || 'Failed to fetch'})</h4>
            <p>Impossible de joindre l'API à l'adresse <code>${url}</code>. Cela est généralement dû à un problème réseau local ou de CORS.</p>
            <ul>
                <li><strong>Le serveur Django est-il démarré ?</strong> Vérifiez dans votre terminal que <code>python manage.py runserver</code> tourne bien.</li>
                <li><strong>localhost vs 127.0.0.1 (IPv6 vs IPv4) :</strong> Si vous utilisez <code>localhost</code>, le navigateur peut essayer de se connecter en IPv6 (<code>::1</code>), ce qui échouera si Django n'écoute qu'en IPv4 (<code>127.0.0.1</code>). Essayez de passer sur <strong>127.0.0.1</strong>.</li>
                <li><strong>Restriction CORS :</strong> Le backend Django doit autoriser l'adresse de ce client (configuration de <code>CORS_ALLOWED_ORIGINS</code> dans <code>settings.py</code>).</li>
                <li><strong>Tunnel Ngrok inactif/expiré :</strong> Si vous testez avec l'URL Ngrok, vérifiez que le tunnel n'est pas expiré ou fermé.</li>
            </ul>
            <div style="margin-top: 14px; display: flex; gap: 10px; flex-wrap: wrap;">
                <button type="button" class="btn btn-primary btn-sm" id="btn-retry-failed-request">🔄 Réessayer la requête</button>
                <button type="button" class="btn btn-secondary btn-sm" id="btn-switch-to-127-err">🔌 Passer sur 127.0.0.1 et réessayer</button>
            </div>
        `;

        panel.insertBefore(banner, panel.firstChild);

        document.getElementById('btn-retry-failed-request').addEventListener('click', () => {
            if (lastRequest) {
                makeAPIRequest(lastRequest.endpoint, lastRequest.method, lastRequest.bodyData, lastRequest.headers);
            }
        });

        document.getElementById('btn-switch-to-127-err').addEventListener('click', () => {
            document.getElementById('api-base-url').value = 'http://127.0.0.1:8000';
            checkServerStatus();
            if (lastRequest) {
                makeAPIRequest(lastRequest.endpoint, lastRequest.method, lastRequest.bodyData, lastRequest.headers);
            }
        });
    }

    function showEmailVerificationHelper(email) {
        const existing = document.getElementById('email-verification-helper');
        if (existing) existing.remove();

        const panel = document.getElementById('response-json-panel');
        if (!panel) return;

        const helper = document.createElement('div');
        helper.className = 'email-verification-helper';
        helper.id = 'email-verification-helper';
        
        helper.style.marginTop = '16px';
        helper.style.padding = '16px';
        helper.style.border = '1px solid var(--success)';
        helper.style.borderLeft = '4px solid var(--success)';
        helper.style.borderRadius = 'var(--radius)';
        helper.style.backgroundColor = 'rgba(16, 185, 129, 0.08)';
        helper.style.color = 'var(--text-main)';
        helper.style.textAlign = 'left';
        
        helper.innerHTML = `
            <h4 style="margin: 0 0 8px 0; color: var(--success); display: flex; align-items: center; gap: 8px;">📧 Validation de l'adresse email</h4>
            <p style="margin: 0 0 8px 0; font-size: 0.9rem;">Un e-mail de confirmation est requis pour activer et utiliser le compte de <strong>${email}</strong>.</p>
            <p style="margin: 0 0 12px 0; font-size: 0.85rem; color: var(--text-muted);">Si vous n'avez pas reçu le mail ou si le lien a expiré, vous pouvez demander le renvoi du lien de confirmation ci-dessous :</p>
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <button type="button" class="btn btn-success btn-sm" id="btn-resend-verification-email" style="background-color: var(--success); border-color: var(--success); color: white;">Renvoyer le lien de confirmation</button>
                <span id="resend-verification-status" style="font-size: 0.85rem; font-weight: 600;"></span>
            </div>
        `;

        panel.appendChild(helper);

        document.getElementById('btn-resend-verification-email').addEventListener('click', async () => {
            const btn = document.getElementById('btn-resend-verification-email');
            const status = document.getElementById('resend-verification-status');
            btn.disabled = true;
            status.textContent = '🔄 Envoi en cours...';
            status.style.color = 'var(--text-muted)';
            
            try {
                const r = await makeAPIRequest('/api/v1/auth/registration/resend-email/', 'POST', { email });
                btn.disabled = false;
                if (r.ok) {
                    status.textContent = '🟢 Renvoyé avec succès !';
                    status.style.color = 'var(--success)';
                } else {
                    const errorDetail = r.data && (r.data.detail || JSON.stringify(r.data));
                    status.textContent = '🔴 Échec : ' + (errorDetail || 'Erreur');
                    status.style.color = 'var(--danger)';
                }
            } catch (err) {
                btn.disabled = false;
                status.textContent = '🔴 Erreur réseau';
                status.style.color = 'var(--danger)';
            }
        });
    }

    async function makeAPIRequest(endpoint, method = 'GET', bodyData = null, headers = {}) {
        const url = `${state.apiBaseUrl}${endpoint}`;
        const outputJsonEl = document.getElementById('response-output-json');
        const statusBadge = document.getElementById('response-status');
        const timeBadge = document.getElementById('response-time');
        
        lastRequest = { endpoint, method, bodyData, headers };

        // Clear any previous banners/helpers
        const existingHelper = document.getElementById('email-verification-helper');
        if (existingHelper) existingHelper.remove();
        const existingBanner = document.getElementById('api-network-error-banner');
        if (existingBanner) existingBanner.remove();

        outputJsonEl.innerHTML = 'Envoi de la requête en cours...';
        statusBadge.className = 'badge';
        statusBadge.textContent = 'STATUS : --';
        timeBadge.textContent = 'TEMPS : -- ms';

        const defaultHeaders = {
            'Accept': 'application/json',
            'X-Client-Type': 'mobile', // Indique à l'API qu'on est un client de type mobile/API (pour recevoir les tokens dans le body JSON)
        };

        if (state.token) {
            defaultHeaders['Authorization'] = `Bearer ${state.token}`;
        }

        if (bodyData && !(bodyData instanceof FormData)) {
            defaultHeaders['Content-Type'] = 'application/json';
        }

        const requestHeaders = { ...defaultHeaders, ...headers };
        const requestInfo = {
            endpoint,
            method,
            url,
            headers: requestHeaders,
            body: bodyData || null
        };
        renderRequestDetails(requestInfo);

        const options = {
            method: method,
            headers: requestHeaders
        };

        if (bodyData) {
            options.body = bodyData instanceof FormData ? bodyData : JSON.stringify(bodyData);
        }

        const startTime = performance.now();
        try {
            const response = await fetch(url, options);
            const duration = Math.round(performance.now() - startTime);
            timeBadge.textContent = `TEMPS : ${duration} ms`;
            
            // Set status code badge
            statusBadge.textContent = `STATUS : ${response.status} ${response.statusText}`;
            statusBadge.className = 'badge';
            if (response.status >= 200 && response.status < 300) {
                statusBadge.classList.add('badge-2xx');
            } else if (response.status >= 300 && response.status < 400) {
                statusBadge.classList.add('badge-3xx');
            } else if (response.status >= 400 && response.status < 500) {
                statusBadge.classList.add('badge-4xx');
            } else {
                statusBadge.classList.add('badge-5xx');
            }

            // Extract json
            let data = null;
            const contentType = response.headers.get('content-type');
            if (contentType && contentType.includes('application/json')) {
                data = await response.json();
            } else {
                data = { message: await response.text() };
            }

            // Remove any existing network error banner
            const existingBanner = document.getElementById('api-network-error-banner');
            if (existingBanner) existingBanner.remove();
            const existingHelper2 = document.getElementById('email-verification-helper');
            if (existingHelper2) existingHelper2.remove();

            outputJsonEl.innerHTML = syntaxHighlightJSON(data);
            recordApiInteraction({ endpoint, method, url, request: requestInfo, status: response.status, ok: response.ok, duration }, data);
            return { ok: response.ok, status: response.status, data };

        } catch (error) {
            const duration = Math.round(performance.now() - startTime);
            timeBadge.textContent = `TEMPS : ${duration} ms`;
            statusBadge.textContent = 'STATUS : ERREUR';
            statusBadge.className = 'badge badge-5xx';
            
            const errObj = { error: error.message || 'Erreur réseau ou CORS' };
            outputJsonEl.innerHTML = syntaxHighlightJSON(errObj);
            recordApiInteraction({ endpoint, method, url, request: requestInfo, status: 0, ok: false, duration }, errObj);
            
            // Show network error diagnostic panel
            displayNetworkErrorBanner(url, error.message);

            return { ok: false, status: 0, data: errObj };
        }
    }

    // JSON syntax highlighting
    function syntaxHighlightJSON(json) {
        if (typeof json !== 'string') {
            json = JSON.stringify(json, null, 2);
        }
        json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        return json.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+-]?\d+)?)/g, function (match) {
            let cls = 'json-number';
            if (/^"/.test(match)) {
                if (/:$/.test(match)) {
                    cls = 'json-key';
                } else {
                    cls = 'json-string';
                }
            } else if (/true|false/.test(match)) {
                cls = 'json-boolean';
            } else if (/null/.test(match)) {
                cls = 'json-null';
            }
            return `<span class="${cls}">${match}</span>`;
        });
    }


    // -------------------------------------------------------------------------
    // 3B. INTERACTIVE RESPONSE UI
    // -------------------------------------------------------------------------
    const responseWorkspace = {
        history: [],
        selected: null
    };

    function escapeHTML(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function switchResponseTab(tabName) {
        document.querySelectorAll('.viewer-tab').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.responseTab === tabName);
        });
        document.getElementById('response-json-panel').classList.toggle('active', tabName === 'json');
        document.getElementById('response-request-panel').classList.toggle('active', tabName === 'request');
        document.getElementById('response-interface-panel').classList.toggle('active', tabName === 'interface');
    }

    function visibleRequestHeaders(headers) {
        const clean = { ...headers };
        if (clean.Authorization) {
            clean.Authorization = clean.Authorization.slice(0, 24) + '...';
        }
        return clean;
    }

    function renderRequestDetails(requestInfo) {
        const output = document.getElementById('request-output-json');
        if (!output) return;
        output.innerHTML = syntaxHighlightJSON({
            method: requestInfo.method,
            url: requestInfo.url,
            endpoint: requestInfo.endpoint,
            headers: visibleRequestHeaders(requestInfo.headers || {}),
            body: requestInfo.body instanceof FormData ? '[FormData]' : (requestInfo.body ?? null)
        });
    }

    function recordApiInteraction(meta, data) {
        const entry = {
            id: Date.now(),
            meta,
            data,
            time: new Date().toLocaleTimeString()
        };
        responseWorkspace.history.unshift(entry);
        responseWorkspace.history = responseWorkspace.history.slice(0, 12);
        renderInteractiveResponse(entry);
    }

    function isPrimitive(value) {
        return value === null || ['string', 'number', 'boolean'].includes(typeof value);
    }

    function isUsefulKey(key) {
        return /(^id$|_id$|pk|slug|email|telephone|phone|numero|number|reference|processing|code)/i.test(key || '');
    }

    function describeValue(value) {
        if (value === null) return 'null';
        if (typeof value === 'string') return value;
        return JSON.stringify(value);
    }

    function getOperationsForSuggestions() {
        if (!endpointExplorer.operations.length && typeof mergeKnownOperations === 'function') {
            endpointExplorer.operations = mergeKnownOperations([]);
        }
        return endpointExplorer.operations || [];
    }

    function pathParamMatches(paramName, selectedKey) {
        const p = String(paramName || '').toLowerCase();
        const k = String(selectedKey || '').toLowerCase();
        if (p === k) return true;
        if ((p === 'id' || p === 'pk') && (k === 'id' || k.endsWith('_id') || k === 'pk')) return true;
        if (p === 'slug' && k.includes('slug')) return true;
        if ((p === 'numero' || p === 'number') && (k.includes('numero') || k.includes('number'))) return true;
        return false;
    }

    function buildFollowupRequest(op, selected) {
        let path = op.path;
        op.parameters.filter(param => param.in === 'path').forEach(param => {
            const value = pathParamMatches(param.name, selected.key) ? selected.value : defaultValueForParameter(param);
            path = path.replace(`{${param.name}}`, encodeURIComponent(value));
        });
        const bodyExample = requestBodyExample(op.operation);
        const body = bodyExample ? parseLooseJSON(bodyExample, {}) : null;
        return { endpoint: path, method: op.method, body, headers: {} };
    }

    function selectResponseValue(key, value, path) {
        responseWorkspace.selected = { key, value, path };
        renderSelectedValue();
        renderFollowupSuggestions();
    }

    function renderSelectedValue() {
        const box = document.getElementById('response-selected-value');
        if (!box) return;
        const selected = responseWorkspace.selected;
        if (!selected) {
            box.innerHTML = '<span class="text-muted">Clique sur une valeur de la reponse pour l\'utiliser.</span>';
            return;
        }
        box.innerHTML = `
            <div class="selected-value-card">
                <span>${escapeHTML(selected.path)}</span>
                <strong>${escapeHTML(describeValue(selected.value))}</strong>
            </div>
        `;
    }

    function renderFollowupSuggestions() {
        const target = document.getElementById('response-followup-actions');
        if (!target) return;
        const selected = responseWorkspace.selected;
        if (!selected) {
            target.innerHTML = '<p class="text-muted">Selectionne une valeur pour voir les endpoints compatibles.</p>';
            return;
        }

        const operations = getOperationsForSuggestions().filter(op => {
            return op.parameters.some(param => param.in === 'path' && pathParamMatches(param.name, selected.key));
        }).slice(0, 24);

        if (!operations.length) {
            target.innerHTML = '<p class="text-muted">Aucun endpoint avec parametre compatible trouve.</p>';
            return;
        }

        target.innerHTML = '';
        operations.forEach(op => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'followup-action-btn';
            btn.innerHTML = `
                <span class="method-pill method-${op.method.toLowerCase()}">${op.method}</span>
                <span>${escapeHTML(op.path)}</span>
            `;
            btn.addEventListener('click', () => {
                const pathValues = {};
                op.parameters.filter(param => param.in === 'path').forEach(param => {
                    pathValues[param.name] = pathParamMatches(param.name, selected.key) ? selected.value : defaultValueForParameter(param);
                });
                prepareOperationInFullTester(op, pathValues);
                switchResponseTab('json');
            });
            target.appendChild(btn);
        });
    }

    function renderResponseTree(value, key = 'response', path = 'response') {
        if (Array.isArray(value)) {
            const details = document.createElement('details');
            details.className = 'response-node';
            details.open = value.length <= 5;
            details.innerHTML = `<summary>${escapeHTML(key)} <span>${value.length} elements</span></summary>`;
            value.slice(0, 50).forEach((item, index) => {
                details.appendChild(renderResponseTree(item, `[${index}]`, `${path}[${index}]`));
            });
            if (value.length > 50) {
                const more = document.createElement('div');
                more.className = 'response-row muted-row';
                more.textContent = `${value.length - 50} elements non affiches`;
                details.appendChild(more);
            }
            return details;
        }

        if (value && typeof value === 'object') {
            const details = document.createElement('details');
            details.className = 'response-node';
            details.open = path === 'response';
            const keys = Object.keys(value);
            details.innerHTML = `<summary>${escapeHTML(key)} <span>${keys.length} champs</span></summary>`;
            keys.forEach(childKey => {
                details.appendChild(renderResponseTree(value[childKey], childKey, `${path}.${childKey}`));
            });
            return details;
        }

        const row = document.createElement('div');
        row.className = `response-row ${isUsefulKey(key) ? 'useful-row' : ''}`;
        const valueText = describeValue(value);
        row.innerHTML = `
            <span class="response-key">${escapeHTML(key)}</span>
            <button type="button" class="response-value-btn">${escapeHTML(valueText)}</button>
        `;
        row.querySelector('button').addEventListener('click', () => selectResponseValue(key, value, path));
        return row;
    }

    function renderHistoryList() {
        const target = document.getElementById('response-history-list');
        if (!target) return;
        target.innerHTML = '';
        responseWorkspace.history.forEach(entry => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'history-item';
            btn.innerHTML = `
                <span>${escapeHTML(entry.time)}</span>
                <strong>${escapeHTML(entry.meta.method)} ${escapeHTML(entry.meta.endpoint)}</strong>
                <small>${entry.meta.status}</small>
            `;
            btn.addEventListener('click', () => { renderRequestDetails(entry.meta.request || entry.meta); renderInteractiveResponse(entry, false); });
            target.appendChild(btn);
        });
    }

    function renderInteractiveResponse(entry, switchTab = false) {
        const panel = document.getElementById('response-interface-panel');
        if (!panel) return;
        panel.innerHTML = `
            <div class="response-interface-layout">
                <aside class="response-side-panel">
                    <div class="response-mini-card">
                        <h4>Requete</h4>
                        <code>${escapeHTML(entry.meta.method)} ${escapeHTML(entry.meta.endpoint)}</code>
                        <span>Status ${entry.meta.status} - ${entry.meta.duration || 0} ms</span>
                    </div>
                    <div class="response-mini-card">
                        <h4>Valeur selectionnee</h4>
                        <div id="response-selected-value"></div>
                    </div>
                    <div class="response-mini-card">
                        <h4>Executer avec cette valeur</h4>
                        <div id="response-followup-actions"></div>
                    </div>
                    <div class="response-mini-card">
                        <h4>Historique</h4>
                        <div id="response-history-list"></div>
                    </div>
                </aside>
                <div class="response-tree-panel" id="response-tree-panel"></div>
            </div>
        `;
        document.getElementById('response-tree-panel').appendChild(renderResponseTree(entry.data));
        renderSelectedValue();
        renderFollowupSuggestions();
        renderHistoryList();
        if (switchTab) switchResponseTab('interface');
    }

    // UI Auth State Update
    function updateAuthStatus() {
        const dot = document.getElementById('auth-status-dot');
        const text = document.getElementById('auth-status-text');
        
        if (state.token) {
            dot.className = 'status-dot online';
            text.textContent = 'Connecté (Session active)';
        } else {
            dot.className = 'status-dot offline';
            text.textContent = 'Non connecté';
        }
    }

    // Base URL Quick Switches & Server checking
    async function checkServerStatus() {
        const badge = document.getElementById('server-status-badge');
        if (!badge) return;
        badge.className = 'server-status-badge status-checking';
        badge.textContent = '🔄 Vérification...';
        
        try {
            const response = await fetch(`${state.apiBaseUrl}/`, {
                method: 'GET',
                mode: 'cors',
                headers: { 'Accept': 'application/json' }
            });
            badge.className = 'server-status-badge status-online';
            badge.textContent = '🟢 En ligne';
        } catch (error) {
            badge.className = 'server-status-badge status-offline';
            badge.textContent = '🔴 Hors ligne';
        }
    }

    document.getElementById('btn-url-127').addEventListener('click', () => {
        document.getElementById('api-base-url').value = 'http://127.0.0.1:8000';
        checkServerStatus();
    });
    document.getElementById('btn-url-local').addEventListener('click', () => {
        document.getElementById('api-base-url').value = 'http://localhost:8000';
        checkServerStatus();
    });
    document.getElementById('btn-url-ngrok').addEventListener('click', () => {
        document.getElementById('api-base-url').value = 'https://integral-logically-gator.ngrok-free.app';
        checkServerStatus();
    });
    
    document.getElementById('api-base-url').addEventListener('change', checkServerStatus);

    // Initial check and periodic polling
    checkServerStatus();
    setInterval(checkServerStatus, 8000);

    // 4. GENERAL ENDPOINTS (ACCUEIL)
    // -------------------------------------------------------------------------
    document.getElementById('btn-check-api').addEventListener('click', () => {
        makeAPIRequest('/', 'GET');
    });

    document.getElementById('btn-check-schema').addEventListener('click', () => {
        makeAPIRequest('/api/schema/', 'GET');
    });

    // Clear token button
    document.getElementById('btn-clear-token').addEventListener('click', () => {
        state.token = '';
        state.refreshToken = '';
        alert('Jeton effacé !');
    });

    // Prepopulate user shortcuts
    document.querySelectorAll('.btn-shortcut').forEach(btn => {
        btn.addEventListener('click', () => {
            const email = btn.getAttribute('data-email');
            const password = btn.getAttribute('data-password') || 'UserPassword123!';
            document.getElementById('login-email').value = email;
            document.getElementById('login-password').value = password;
            // Switch to auth tab
            document.querySelector('.nav-btn[data-target="auth-panel"]').click();
            document.querySelector('.tab-sub-btn[data-sub="login-sub"]').click();
        });
    });

    // Random user details generator for registration
    document.getElementById('btn-random-register').addEventListener('click', () => {
        const rand = Math.floor(Math.random() * 100000);
        document.getElementById('reg-email').value = `testuser${rand}@example.com`;
        document.getElementById('reg-password').value = `UserPassword123!`;
        document.getElementById('reg-password-confirm').value = `UserPassword123!`;
        document.getElementById('reg-first-name').value = `Prénom${rand}`;
        document.getElementById('reg-last-name').value = `Nom${rand}`;
        
        // Random Cameroon phone number starting with +237 6
        const randPhone = "+2376" + Array.from({length: 8}, () => Math.floor(Math.random() * 10)).join('');
        document.getElementById('reg-telephone').value = randPhone;
    });

    // -------------------------------------------------------------------------
    // 5. AUTHENTICATION & PROFILE
    // -------------------------------------------------------------------------
    // Login
    document.getElementById('form-login').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('login-email').value.trim();
        const password = document.getElementById('login-password').value;

        const body = {};
        if (email.includes('@')) {
            body.email = email;
        } else {
            body.telephone = email;
        }
        body.password = password;

        const res = await makeAPIRequest('/api/v1/auth/mobile/login/', 'POST', body);
        if (res.ok && res.data) {
            storeAuthTokensFromResponse(res.data);
        } else if (res.data && res.data.email_non_verifie) {
            showEmailVerificationHelper(res.data.email);
        }
    });

    function storeAuthTokensFromResponse(data) {
        if (!data) return;
        if (data.access) state.token = data.access;
        if (data.key && !data.access) state.token = data.key;
        if (data.refresh) state.refreshToken = data.refresh;
    }

    // Register
    document.getElementById('form-register').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('reg-email').value.trim();
        const password = document.getElementById('reg-password').value;
        const password_confirm = document.getElementById('reg-password-confirm').value;
        const first_name = document.getElementById('reg-first-name').value.trim();
        const last_name = document.getElementById('reg-last-name').value.trim();
        const telephone = document.getElementById('reg-telephone').value.trim();

        if (password !== password_confirm) {
            return alert('Les deux mots de passe ne correspondent pas.');
        }

        // CustomRegisterSerializer attend: email, password, password_confirm.
        // first_name, last_name et telephone sont optionnels et acceptés dans le même appel.
        const body = { email, password, password_confirm };
        if (first_name) body.first_name = first_name;
        if (last_name) body.last_name = last_name;
        if (telephone) body.telephone = telephone;

        const res = await makeAPIRequest('/api/v1/auth/registration/', 'POST', body);
        if (res.ok) {
            storeAuthTokensFromResponse(res.data);
            showEmailVerificationHelper(email);
        } else {
            if (email && email.includes('@')) {
                showEmailVerificationHelper(email);
            }
        }
    });

    function loadGoogleIdentityScript() {
        if (window.google && window.google.accounts && window.google.accounts.oauth2) {
            return Promise.resolve();
        }
        return new Promise((resolve, reject) => {
            const existing = document.querySelector('script[data-google-identity="true"]');
            if (existing) {
                existing.addEventListener('load', resolve, { once: true });
                existing.addEventListener('error', reject, { once: true });
                return;
            }
            const script = document.createElement('script');
            script.src = 'https://accounts.google.com/gsi/client';
            script.async = true;
            script.defer = true;
            script.dataset.googleIdentity = 'true';
            script.onload = resolve;
            script.onerror = () => reject(new Error('Impossible de charger Google Identity Services.'));
            document.head.appendChild(script);
        });
    }

    async function submitGoogleToken(accessToken, idToken = '') {
        const body = { access_token: accessToken };
        if (idToken) body.id_token = idToken;
        const res = await makeAPIRequest('/api/v1/auth/google/', 'POST', body);
        if (res.ok) storeAuthTokensFromResponse(res.data);
        return res;
    }

    function saveGoogleClientId(clientId) {
        localStorage.setItem('google_client_id', clientId);
    }

    const savedGoogleClientId = localStorage.getItem('google_client_id');
    if (savedGoogleClientId) {
        document.getElementById('google-client-id').value = savedGoogleClientId;
    }

    document.getElementById('btn-google-auto-login').addEventListener('click', async () => {
        const clientId = document.getElementById('google-client-id').value.trim();
        if (!clientId) return alert('Renseigne ton Google Client ID.');
        saveGoogleClientId(clientId);

        try {
            await loadGoogleIdentityScript();
            const tokenClient = google.accounts.oauth2.initTokenClient({
                client_id: clientId,
                scope: 'openid email profile',
                callback: async (tokenResponse) => {
                    if (tokenResponse.error) {
                        document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON(tokenResponse);
                        return;
                    }
                    const accessToken = tokenResponse.access_token;
                    document.getElementById('google-access-token').value = accessToken || '';
                    await submitGoogleToken(accessToken);
                }
            });
            tokenClient.requestAccessToken({ prompt: 'consent' });
        } catch (error) {
            document.getElementById('response-output-json').innerHTML = syntaxHighlightJSON({ error: error.message });
        }
    });

    // Google Login / Signup
    document.getElementById('form-google-login').addEventListener('submit', async (e) => {
        e.preventDefault();
        const accessToken = document.getElementById('google-access-token').value.trim();
        const idToken = document.getElementById('google-id-token').value.trim();
        if (!accessToken) return alert('Colle un access_token Google.');
        await submitGoogleToken(accessToken, idToken);
    });

    // Load Me
    document.getElementById('btn-get-me').addEventListener('click', () => {
        makeAPIRequest('/api/v1/auth/me/', 'GET');
    });

    // Logout
    document.getElementById('btn-logout').addEventListener('click', async () => {
        await makeAPIRequest('/api/v1/auth/logout/', 'POST');
        state.token = '';
        state.refreshToken = '';
    });

    // Change Email
    document.getElementById('form-change-email').addEventListener('submit', async (e) => {
