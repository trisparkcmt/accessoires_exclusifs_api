    // -------------------------------------------------------------------------
    
    // Parfums
    document.getElementById('btn-list-parfums').addEventListener('click', async () => {
        const res = await makeAPIRequest('/api/v1/shop/parfums/', 'GET');
        renderParfums(res.data);
    });

    document.getElementById('form-filter-parfums').addEventListener('submit', async (e) => {
        e.preventDefault();
        const params = new URLSearchParams();
        const search = document.getElementById('p-search').value.trim();
        const genre = document.getElementById('p-genre').value;
        const famille = document.getElementById('p-famille').value.trim();
        const pMin = document.getElementById('p-prix-min').value;
        const pMax = document.getElementById('p-prix-max').value;
        const bestseller = document.getElementById('p-bestseller').checked;
        const nouveau = document.getElementById('p-nouveau').checked;

        if (search) params.append('search', search);
        if (genre) params.append('genre', genre);
        if (famille) params.append('famille_olfactive', famille);
        if (pMin) params.append('prix_min', pMin);
        if (pMax) params.append('prix_max', pMax);
        if (bestseller) params.append('est_bestseller', 'true');
        if (nouveau) params.append('est_nouveau', 'true');

        const res = await makeAPIRequest(`/api/v1/shop/parfums/?${params.toString()}`, 'GET');
        renderParfums(res.data);
    });

    document.getElementById('btn-get-parfum').addEventListener('click', () => {
        const slug = document.getElementById('p-slug').value.trim();
        if (!slug) return alert('Indiquez un slug de parfum.');
        makeAPIRequest(`/api/v1/shop/parfums/${slug}/`, 'GET');
    });

    function renderParfums(data) {
        const listContainer = document.getElementById('parfums-list-output');
        listContainer.innerHTML = '';
        
        const results = data.results || data || [];
        if (results.length === 0) {
            listContainer.innerHTML = '<p class="text-muted">Aucun parfum trouvé.</p>';
            return;
        }

        results.forEach(parfum => {
            const card = document.createElement('div');
            card.className = 'catalog-card';
            
            let badges = '';
            if (parfum.est_nouveau) badges += '<span class="badge-card badge-new">Nouveau</span>';
            if (parfum.est_bestseller) badges += '<span class="badge-card badge-bestseller">Bestseller</span>';

            card.innerHTML = `
                ${badges}
                <h4>${parfum.nom}</h4>
                <div class="sku">SKU: ${parfum.reference_sku || 'N/A'}</div>
                <div class="description">${parfum.description_courte || 'Pas de description'}</div>
                <div class="price">${parfum.prix_actuel || parfum.prix_unitaire} FCFA</div>
                <div class="btn-group mt-2">
                    <button class="btn btn-secondary btn-sm btn-fav-add" data-id="${parfum.id}">❤️</button>
                    <button class="btn btn-primary btn-sm btn-view-details" data-slug="${parfum.slug}">Détails</button>
                </div>
            `;
            listContainer.appendChild(card);
        });

        // Attach card actions
        listContainer.querySelectorAll('.btn-fav-add').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const id = btn.getAttribute('data-id');
                addFavori(id);
            });
        });

        listContainer.querySelectorAll('.btn-view-details').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const slug = btn.getAttribute('data-slug');
                document.getElementById('p-slug').value = slug;
                makeAPIRequest(`/api/v1/shop/parfums/${slug}/`, 'GET');
            });
        });
    }

