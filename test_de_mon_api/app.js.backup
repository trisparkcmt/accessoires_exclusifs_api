    // -------------------------------------------------------------------------
    // 10. OPENAPI ENDPOINT EXPLORER
    // -------------------------------------------------------------------------
    const endpointExplorer = {
        operations: [],
        selected: null
    };

    const HTTP_METHODS = ['get', 'post', 'put', 'patch', 'delete'];

    function parseLooseJSON(value, fallback = {}) {
        const trimmed = value.trim();
        if (!trimmed) return fallback;
        try {
            return JSON.parse(trimmed);
        } catch (error) {
            throw new Error(`JSON invalide: ${error.message}`);
        }
    }

    function normalizeSchemaPath(path) {
        return path.startsWith('/') ? path : `/${path}`;
    }

    function operationLabel(operation, method, path) {
        return operation.summary || operation.operationId || `${method.toUpperCase()} ${path}`;
    }

    function schemaExampleFromObject(schema) {
        if (!schema || typeof schema !== 'object') return {};
        if (schema.example !== undefined) return schema.example;
        if (schema.default !== undefined) return schema.default;
        if (schema.type === 'array') return [];
        if (schema.properties) {
            return Object.fromEntries(Object.entries(schema.properties).map(([key, prop]) => {
                if (prop.example !== undefined) return [key, prop.example];
                if (prop.default !== undefined) return [key, prop.default];
                if (prop.type === 'integer' || prop.type === 'number') return [key, 0];
                if (prop.type === 'boolean') return [key, false];
                if (prop.type === 'array') return [key, []];
                if (prop.type === 'object') return [key, {}];
                return [key, ''];
            }));
        }
        return {};
    }

    function requestBodyExample(operation) {
        const content = operation.requestBody && operation.requestBody.content;
        if (!content) return '';
        const jsonContent = content['application/json'] || Object.values(content)[0];
        if (!jsonContent) return '';
        return JSON.stringify(schemaExampleFromObject(jsonContent.schema), null, 2);
    }

    async function fetchOpenAPISchema() {
        lastRequest = { endpoint: '/api/schema/', method: 'GET', bodyData: null, headers: {} };
        try {
            const response = await fetch(`${state.apiBaseUrl}/api/schema/`, {
                headers: {
                    'Accept': 'application/vnd.oai.openapi+json, application/json',
                    ...(state.token ? { 'Authorization': `Bearer ${state.token}` } : {})
                }
            });
            const text = await response.text();
            if (!response.ok) {
                throw new Error(`Schema indisponible (${response.status}) ${text.slice(0, 160)}`);
            }
            try {
                return JSON.parse(text);
            } catch (error) {
                throw new Error('Le schema recu n\'est pas du JSON. Verifie que /api/schema/ renvoie OpenAPI JSON.');
            }
        } catch (error) {
            // Show network error diagnostic panel if it's a Failed to fetch or connection error
            if (error.message.includes('fetch') || error.message.includes('network') || error.message.includes('connexion') || error.message.includes('Failed')) {
                displayNetworkErrorBanner(`${state.apiBaseUrl}/api/schema/`, error.message);
            }
            throw error;
        }
    }

    function extractOperations(schema) {
        const operations = [];
        Object.entries(schema.paths || {}).forEach(([path, pathItem]) => {
            HTTP_METHODS.forEach(method => {
                const operation = pathItem[method];
                if (!operation) return;
                const parameters = operation.parameters || [];
                operations.push({
                    method: method.toUpperCase(),
                    path: normalizeSchemaPath(path),
                    label: operationLabel(operation, method, path),
                    summary: operation.description || operation.summary || '',
                    tags: operation.tags || [],
                    parameters,
                    requestBody: operation.requestBody || null,
                    operation
                });
            });
        });
        return operations.sort((a, b) => `${a.path} ${a.method}`.localeCompare(`${b.path} ${b.method}`));
    }

    function renderEndpointList() {
        const listEl = document.getElementById('endpoint-list');
        const search = document.getElementById('endpoint-search').value.trim().toLowerCase();
        const operations = endpointExplorer.operations.filter(op => {
            const haystack = `${op.method} ${op.path} ${op.label} ${op.tags.join(' ')}`.toLowerCase();
            return !search || haystack.includes(search);
        });

        if (!operations.length) {
            listEl.innerHTML = '<p class="text-muted text-center">Aucun endpoint trouve.</p>';
            return;
        }

        listEl.innerHTML = '';
        operations.forEach((op, index) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'endpoint-item';
            btn.dataset.index = endpointExplorer.operations.indexOf(op);
            btn.innerHTML = `
                <span class="method-pill method-${op.method.toLowerCase()}">${op.method}</span>
                <span class="endpoint-item-main">
                    <strong>${op.path}</strong>
                    <small>${op.label}</small>
                </span>
            `;
            btn.addEventListener('click', () => selectEndpoint(Number(btn.dataset.index)));
            listEl.appendChild(btn);
        });
    }

    function expectedPathValue(name, path) {
        const n = name.toLowerCase();
        const p = path.toLowerCase();
        if (n === 'slug') {
            if (p.includes('parfum')) return 'royal-oud';
            if (p.includes('accessoire')) return 'coffret-luxe';
            if (p.includes('flacon')) return 'flacon-std-50';
            if (p.includes('essence')) return 'essence-rose';
            if (p.includes('tag')) return 'saison-ete';
            if (p.includes('categorie')) return 'boises';
            return 'royal-oud';
        }
        if (n === 'id' || n === 'pk') {
            return 1;
        }
        if (n === 'email') return 'admin@example.com';
        return 'test';
    }

    function expectedQueryValue(param, path) {
        if (param.defaultValue !== undefined) return param.defaultValue;
        if (param.example !== undefined) return param.example;
        if (param.schema && param.schema.example !== undefined) return param.schema.example;
        if (param.schema && param.schema.default !== undefined) return param.schema.default;
        
        const name = param.name.toLowerCase();
        if (name === 'search') return '';
        if (name === 'page') return 1;
        if (name === 'page_size') return 10;
        if (name === 'ordering') return '';
        return '';
    }

