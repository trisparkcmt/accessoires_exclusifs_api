# Configuration API Test Suite

# URL de base de l'API
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Timeout pour les requêtes (secondes)
REQUEST_TIMEOUT=10

# Mode de test
# OPTIONS: all, quick, smoke
TEST_MODE=all

# Affichage détaillé
VERBOSE=true

# Sauvegarder les résultats
SAVE_RESULTS=true

# Afficher les réponses complètes
SHOW_RESPONSES=false

# Utilisateurs de test (optionnel - sinon utilise endpoints.json)
SUPERADMIN_EMAIL=admin@test.com
SUPERADMIN_PASSWORD=AdminPassword123!

SERVEUSE_EMAIL=serveuse@test.com
SERVEUSE_PASSWORD=ServeusePassword123!

PRESTATAIRE_EMAIL=prestataire@test.com
PRESTATAIRE_PASSWORD=PrestatairePassword123!

LIVREUR_EMAIL=livreur@test.com
LIVREUR_PASSWORD=LivreurPassword123!

CLIENT_EMAIL=client@test.com
CLIENT_PASSWORD=ClientPassword123!

# Paramètres de test
# ID d'exemple pour les tests (remplacer par de vrais IDs après création)
TEST_USER_ID=2
TEST_PRESTATAIRE_ID=1
TEST_LIVREUR_ID=1
TEST_SERVEUSE_ID=1
TEST_COMMANDE_ID=1

# Tests spécifiques
# Décommenter pour skip certaines catégories
# SKIP_ADMIN=false
# SKIP_SERVEUSE=false
# SKIP_BOUTIQUE=false
# SKIP_COMMANDES=false
