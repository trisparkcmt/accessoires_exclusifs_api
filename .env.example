# ============================================================
# CONFIGURATION PRODUCTION — HOSTINGER VPS (Accessoires Exclusifs)
# ============================================================

# 1. Django Core & Sécurité
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=votre_cle_secrete_django_production_tres_longue_et_securisee_ici

# 2. Hôtes & Domaines autorisés
ALLOWED_HOSTS=api.accessoiresexclusifs.com,accessoiresexclusifs.com,www.accessoiresexclusifs.com,127.0.0.1,localhost
FRONTEND_URL=https://accessoiresexclusifs.com
CSRF_TRUSTED_ORIGINS=https://api.accessoiresexclusifs.com,https://accessoiresexclusifs.com,https://www.accessoiresexclusifs.com
CORS_ALLOWED_ORIGINS=https://accessoiresexclusifs.com,https://www.accessoiresexclusifs.com

# 3. Sécurité des Cookies (restreints au domaine principal et ses sous-domaines)
JWT_AUTH_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_DOMAIN=.accessoiresexclusifs.com
CSRF_COOKIE_DOMAIN=.accessoiresexclusifs.com

# 4. Configuration Email (SMTP Gmail)
EMAIL_SEND=accessoiresexclusifs@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application_gmail

# 5. Django Allauth — Configuration compte & social
ACCOUNT_AUTHENTICATION_METHOD=email
ACCOUNT_EMAIL_REQUIRED=True
ACCOUNT_EMAIL_VERIFICATION=mandatory
ACCOUNT_USERNAME_REQUIRED=False
ACCOUNT_UNIQUE_EMAIL=True
ACCOUNT_CHANGE_EMAIL=True

SOCIALACCOUNT_AUTO_SIGNUP=True
SOCIALACCOUNT_LOGIN_ON_GET=True
SOCIALACCOUNT_EMAIL_AUTHENTICATION_AUTO_CONNECT=True
SOCIALACCOUNT_EMAIL_AUTHENTICATION=True

# 6. Base de données (SQLite par défaut, PostgreSQL via DATABASE_URL)
# DATABASE_URL=postgres://user:password@localhost:5432/accessoires_db

# 7. Clefs API externes
GEMINI_API_KEY=votre_cle_api_gemini
LLM_PROVIDER=gemini
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b

# 8. AWS S3 / CloudFront (Stockage médias en production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-3
CLOUDFRONT_DOMAIN=

# 9. Campay Payouts (Mobile Money — prestataires)
CAMPAY_API_URL=https://demo.campay.net/api
CAMPAY_API_TOKEN=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_SECRET=
CAMPAY_WEBHOOK_URL=https://api.accessoiresexclusifs.com/api/v1/auth/payout/webhook/

# 10. Firebase Admin SDK (Notifications Push FCM)
# Option A — JSON encodé en base64 :  base64 -w 0 serviceAccountKey.json
# FIREBASE_CREDENTIALS_BASE64=
# Option B — Chemin vers le fichier JSON :
# FIREBASE_CREDENTIALS_PATH=/home/user/serviceAccountKey.json
