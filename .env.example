# ============================================================
# CONFIGURATION PRODUCTION — HOSTINGER VPS (Accessoires Exclusifs)
# ============================================================

# 1. Django Core & Sécurité
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=votre_cle_secrete_django_production_tres_longue_et_securisee_ici

# 2. Hôtes & Domaines autorisés
ALLOWED_HOSTS=accessoiresexclusifs.com,www.accessoiresexclusifs.com,127.0.0.1,localhost
FRONTEND_URL=https://accessoiresexclusifs.com
CSRF_TRUSTED_ORIGINS=https://accessoiresexclusifs.com,https://www.accessoiresexclusifs.com
CORS_ALLOWED_ORIGINS=https://accessoiresexclusifs.com,https://www.accessoiresexclusifs.com

# 3. Sécurité des Cookies (Restriction au même domaine / sous-domaines)
JWT_AUTH_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_DOMAIN=.accessoiresexclusifs.com

# 4. Configuration Email (SMTP)
EMAIL_SEND=accessoiresexclusifs@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application_gmail

# 5. Base de données PostgreSQL (ou SQLite local pour la prod si SQLite est conservé)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# 6. Clefs API externes
GEMINI_API_KEY=votre_cle_api_gemini
LLM_PROVIDER=gemini

# 7. Campay Payouts (Mobile Money)
CAMPAY_API_URL=https://demo.campay.net/api
CAMPAY_API_TOKEN=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_SECRET=
CAMPAY_WEBHOOK_URL=https://accessoiresexclusifs.com/api/v1/auth/payout/webhook/

# 8. Firebase Admin SDK (Notifications Push)
# Encoder la clé JSON en base64 : base64 -w 0 serviceAccountKey.json
# FIREBASE_CREDENTIALS_BASE64=
